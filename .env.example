# SmartVyapar Backend Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.

# Google OAuth Credentials (Obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Application Security & Settings
SECRET_KEY=your-production-secret-key-here
ENVIRONMENT=production

# Database Configuration (Optional)
# 1. Default (SQLite): Leave blank or commented out. Data is stored in database/smartvyapar.db
# DATABASE_URL=

# 2. Hostinger MySQL Database (Optional):
# DATABASE_URL=mysql+pymysql://db_user:db_password@localhost/db_name
